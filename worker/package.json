{
  "name": "claude-talk-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "노트북 워커: NAS ingest 와 웹소켓으로 붙어 대화 턴을 실행",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "once": "tsx src/once.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.308",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openai/codex-sdk": "0.163.0",
    "chokidar": "6.0.0",
    "parse5": "8.0.1",
    "pino": "9.14.0",
    "playwright-core": "1.64.1",
    "ws": "8.22.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
